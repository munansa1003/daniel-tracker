# Daniel Tracker — 환경변수 예시
# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 git에 커밋되지 않습니다)
#
# 로컬 개발: 프로젝트 루트의 .env 에 작성
# 배포(Vercel): 프로젝트 Settings → Environment Variables 에 등록

# ─────────────────────────────────────────────
# 프론트엔드 (빌드 시 번들에 주입 — VITE_ 접두사 필수)
# ─────────────────────────────────────────────

# Firebase App Check 용 reCAPTCHA v3 사이트 키.
# 프로덕션에서 미설정 시 App Check가 비활성화되며,
# firestore.rules(request.app != null)가 배포돼 있으면 앱이 Firestore에 접근 못 함.
VITE_RECAPTCHA_SITE_KEY=

# ─────────────────────────────────────────────
# 서버리스 함수 (api/*) — 클라이언트에 노출되지 않음
# ─────────────────────────────────────────────

# Anthropic Claude API 키 (음식/운동/체성분 AI 분석에 필수)
ANTHROPIC_API_KEY=

# 웹푸시 VAPID 키 (선택 — 리마인더·주간 성적표 푸시. npx web-push generate-vapid-keys)
# VITE_VAPID_PUBLIC_KEY 는 프론트(빌드) 주입, 나머지는 서버리스 전용
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 크론 엔드포인트 보호 — ⚠️ **필수**. 없으면 예약 푸시가 503으로 정지한다.
# 이 엔드포인트는 구독자 전원에게 푸시를 발송하므로, 값이 없을 때 열어두는 것보다
# 멈추는 쪽이 안전하다(2026-08 감사 R-40). Vercel Cron은 이 값이 설정돼 있으면
# Authorization: Bearer <secret> 헤더를 자동으로 붙인다 — 값만 넣으면 그대로 동작한다.
# 생성 예: openssl rand -hex 32
# 밤 8시 푸시가 안 오면 Vercel 로그에서 503 + "CRON_SECRET 미설정"을 먼저 확인할 것.
CRON_SECRET=

# push-sync의 Firebase ID 토큰 검증용 웹 API 키 (선택 — 미설정 시 코드의 공개 키 사용)
FIREBASE_WEB_API_KEY=

# 운영자 이메일 교체용 (선택 — 기본은 코드 하드코딩. firestore.rules isOwner()도 함께 수정)
VITE_OWNER_EMAIL=

# 프로덕션 도메인 화이트리스트 (API origin 검증).
# 콤마(,)로 여러 개 지정 가능. 예: https://your-app.vercel.app,https://your-domain.com
PRODUCTION_ORIGIN=

# ─────────────────────────────────────────────
# 자동 유입 ① 애플워치 운동 · HAE 체성분 (api/health-import.js · api/body-import.js)
# 아래 3종이 전부 있어야 수신이 열린다 — 하나라도 없으면 503으로 잠긴다(실수 배포 방지).
# ─────────────────────────────────────────────

# 단축어가 X-Import-Token 헤더에 실어 보낼 비밀값. 생성 예: openssl rand -hex 32
IMPORT_TOKEN=
# 기록 주인의 Firebase uid — 수신분이 귀속될 사서함의 주인
IMPORT_UID=
# 이 날짜(YYYY-MM-DD) 이전에 "시작된" 운동은 거부 — 과거 수동 기록과 이중 계상 차단
IMPORT_CUTOVER_DATE=
# 체성분 컷오버(위와 독립) — 이 날짜 이전 측정은 거부
IMPORT_BODY_CUTOVER_DATE=
# 수신 시각을 사용자 벽시계로 재표기할 시간대 (선택 — 기본 +09:00)
# IMPORT_TZ_OFFSET=+09:00

# ─────────────────────────────────────────────
# 자동 유입 ② 인바디 클라우드 직수신 (api/_lib/inbody-cloud.js)
#
# ⚠️ 사고 반경: 아래 두 값은 인바디 계정의 **로그인 자격증명 그 자체**다. 유출되면 이 앱의
#    데이터가 아니라 인바디 계정 전체(측정 이력 전부)가 열린다. 다른 env와 위험도가 다르다.
#    - 저장 위치는 Vercel 환경변수 한 곳으로 유지한다(코드·백업 파일·로그에 넣지 않는다).
#    - 이 앱은 실패 시 로그에 값이 아니라 "형태"(길이·앞 3자)만 남긴다.
#    - 유출이 의심되면 인바디 앱에서 비밀번호를 먼저 바꾸고, 그 다음 이 값을 교체한다.
#    - 인바디는 **연속 로그인 실패 3회에 계정을 잠근다**. 값을 바꿀 때 오타를 내면 잠길 수
#      있으므로, 저장 직후 설정 카드의 "지금 확인"으로 1회만 검증한다(연타 금지).
#    비워 두면 직수신 기능만 꺼지고 나머지는 정상 동작한다(선택 기능).
# ─────────────────────────────────────────────

INBODY_LOGIN_ID=
INBODY_LOGIN_PW=
# 국가 코드 (선택 — 기본 KR)
# INBODY_COUNTRY=KR

# ─────────────────────────────────────────────
# 공유 뷰 진단용 고정 토큰 (선택 — 가상 샘플 페이지를 여는 용도)
# 미설정이면 해당 경로만 비활성. ?diag=1 진단 응답에는 값이 아니라 설정 여부·길이만 실린다.
# ─────────────────────────────────────────────

SHARE_TEST_TOKEN=

# ─────────────────────────────────────────────
# Rate Limit 저장소 (선택 — 미설정 시 rate limit이 fail-open으로 통과됨)
# Vercel의 Upstash 통합 시 자동 주입되거나, 아래 둘 중 한 쌍을 직접 설정
# ─────────────────────────────────────────────

KV_REST_API_URL=
KV_REST_API_TOKEN=
# 또는
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 참고: VERCEL_URL, NODE_ENV 는 Vercel이 자동 주입하므로 설정 불필요.
