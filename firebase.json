{
  "functions": [
    {
      "source": ".",
      "codebase": "bodyplan",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".github",
        ".claude",
        "dist",
        "docs",
        "bench",
        "fixtures",
        "public",
        "scripts",
        "src/__tests__",
        "*.log",
        ".env.local",
        ".env.*.local",
        ".secret.local"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/push-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/registerSW.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/manifest.webmanifest", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ],
    "rewrites": [
      { "source": "/api/health-import", "function": { "functionId": "ingress", "region": "asia-northeast3", "pinTag": true } },
      { "source": "/api/body-import", "function": { "functionId": "ingress", "region": "asia-northeast3", "pinTag": true } },
      { "source": "/export/diag", "function": { "functionId": "exportView", "region": "asia-northeast3", "pinTag": true } },
      { "source": "/export/view", "function": { "functionId": "exportView", "region": "asia-northeast3", "pinTag": true } },
      { "source": "/export/view/**", "function": { "functionId": "exportView", "region": "asia-northeast3", "pinTag": true } },
      { "source": "/api/**", "function": { "functionId": "api", "region": "asia-northeast3", "pinTag": true } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "functions": { "port": 5001 },
    "hosting": { "port": 5000 },
    "firestore": { "port": 8080 },
    "auth": { "port": 9099 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
