# Daniel Tracker — 환경변수 예시
#
# ─────────────────────────────────────────────
# ⚠️ 먼저 읽을 것 — 파일 이름 규칙 (Firebase 이전 후 바뀐 부분)
# ─────────────────────────────────────────────
# 이 저장소의 **루트가 곧 Cloud Functions의 소스 디렉터리**다(firebase.json `functions.source: "."`).
# 그래서 루트에 둔 값 파일은 배포 업로드에 딸려 갈 수 있고, Firebase가 읽는 파일 이름도 정해져 있다.
#
#   .env                   ❌ **만들지 말 것.** Firebase가 "모든 프로젝트 공통 함수 env"로 읽는 이름이라
#                             로컬 Vite 비밀을 여기 두면 프로덕션 함수에 그대로 실린다.
#   .env.local             ✅ 로컬 개발용(Vite + 함수 에뮬레이터). 배포에는 실리지 않는다.
#   .env.<projectId>       ✅ 프로젝트별 함수 env. **커밋하지 않는다** — CI가 배포 직전에
#                             GitHub Variables로 만든다(docs/migration/03-ci-deploy-design.md §6).
#   .secret.local          ✅ 에뮬레이터용 시크릿. 커밋 금지.
#
# 진짜 비밀값(아래 "시크릿" 표시)은 파일이 아니라 **Google Secret Manager**에 둔다:
#   firebase functions:secrets:set NAME --project <projectId>
# GitHub Secrets에는 두지 않는다(값 저장소를 한 곳으로 유지 — 03 §5 A안).
#
# 배포(Vercel, 병행 기간): 프로젝트 Settings → Environment Variables

# ─────────────────────────────────────────────
# 프론트엔드 (빌드 시 번들에 주입 — VITE_ 접두사 필수)
# 값이 번들에 그대로 실리므로 비밀이 아니다 → CI에서는 GitHub **Variables**로 주입한다.
# ─────────────────────────────────────────────

# Firebase App Check 용 reCAPTCHA v3 사이트 키.
# 프로덕션에서 미설정 시 App Check가 비활성화되며,
# firestore.rules(request.app != null)가 배포돼 있으면 앱이 Firestore에 접근 못 함.
VITE_RECAPTCHA_SITE_KEY=

# Firebase Auth의 authDomain 교체용 (선택 — 미설정이면 기본 <project>.firebaseapp.com).
# Hosting 커스텀 도메인을 여기에 넣으면 iOS 홈 화면 앱의 redirect 로그인이 서드파티 저장소
# 차단에 걸리지 않는다(DR-12). 넣을 때는 [콘솔] 두 곳도 함께:
#   ① Firebase Authentication → Authorized domains 에 그 도메인 추가
#   ② GCP OAuth 클라이언트의 승인된 리디렉션 URI에 https://<도메인>/__/auth/handler 추가
# Vercel에는 이 변수를 두지 않는다 → 옛 원점은 현행 authDomain 그대로 동작한다.
VITE_AUTH_DOMAIN=

# 새 원점 안내 배너용 (선택). 값이 있고 지금 보고 있는 주소가 vercel.app이면
# 홈 상단에 "새 주소로 이동" 배너가 하루 1회 뜬다. 미설정이면 배너 자체가 렌더되지 않는다.
VITE_NEW_ORIGIN=

# 운영자 이메일 교체용 (선택 — 기본은 코드 하드코딩. firestore.rules isOwner()도 함께 수정)
VITE_OWNER_EMAIL=

# ─────────────────────────────────────────────
# 서버리스 함수 (api/*) — 클라이언트에 노출되지 않음
# ─────────────────────────────────────────────

# 【시크릿】 Anthropic Claude API 키 (음식/운동/체성분 AI 분석에 필수)
# Firebase: 함수 그룹 `api`에 바인딩
ANTHROPIC_API_KEY=

# 웹푸시 VAPID (선택 — 리마인더·주간 성적표 푸시. npx web-push generate-vapid-keys)
# VITE_VAPID_PUBLIC_KEY 는 프론트(빌드) 주입 + 함수에서도 같은 이름으로 읽는다.
# VAPID_PRIVATE_KEY 는 【시크릿】 — 함수 그룹 `cronReminders`에 바인딩.
# 키 쌍은 원점에 묶이지 않으므로 이전 후에도 **그대로 재사용**한다(02 §1 #4).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 크론 엔드포인트 보호 — **Vercel 전용**. ⚠️ Vercel에서는 필수다(없으면 예약 푸시가 503으로 정지).
# 이 엔드포인트는 구독자 전원에게 푸시를 발송하므로, 값이 없을 때 열어두는 것보다 멈추는 쪽이
# 안전하다(2026-08 감사 R-40). Vercel Cron은 이 값이 설정돼 있으면
# Authorization: Bearer <secret> 헤더를 자동으로 붙인다 — 값만 넣으면 그대로 동작한다.
# 생성 예: openssl rand -hex 32
#
# Firebase에서는 **설정하지 않는다**. onSchedule 함수는 Cloud Scheduler 잡의 서비스 계정에만
# run.invoker 권한이 있어, URL을 알아도 인터넷에서 호출할 수 없다(방벽이 비밀값이 아니라 IAM).
CRON_SECRET=

# push-sync/verify-* 의 Firebase ID 토큰 검증용 웹 API 키 (선택 — 미설정 시 코드의 공개 키 사용).
# ⚠️ 이름이 둘이다: Functions env는 `FIREBASE_` 접두사를 예약어로 거부하므로 Firebase에서는
# 반드시 새 이름 WEB_API_KEY 를 쓴다. 코드는 새 이름 → 옛 이름 → 공개 폴백 순으로 읽으므로
# 병행 기간에 양쪽이 다 동작한다. 값은 번들에 이미 공개된 웹 키라 비밀이 아니다.
WEB_API_KEY=
# FIREBASE_WEB_API_KEY=   # (옛 이름 — Vercel에서만 유효)

# 프로덕션 도메인 화이트리스트 (API origin 검증).
# 콤마(,)로 여러 개 지정 가능. 예: https://your-domain.com,https://daniel-tracker-cb781.web.app
PRODUCTION_ORIGIN=

# 프리뷰 채널 원점 허용 — **스테이징 전용. prod에는 두지 않는다(비워 두면 완전 off).**
# Hosting 프리뷰 채널 주소는 배포마다 호스트가 달라(<project>--<채널>-<해시>.web.app) 목록으로
# 못 적는다. 콤마로 여러 개를 적을 수 있고, 두 가지 형태를 받는다:
#   bodyplan-staging--*.web.app   ← 권장. `*`는 점을 넘지 않는 한 조각과만 맞으므로
#                                   **그 프로젝트의 채널만** 열린다.
#   .web.app                      ← 순수 접미사. 남의 Firebase 사이트까지 열리므로 권하지 않는다.
# 프로젝트 이름이 호스트의 앞에 오기 때문에, 순수 접미사로는 프로젝트를 묶을 수 없다.
PREVIEW_ORIGIN_SUFFIX=

# ─────────────────────────────────────────────
# 자동 유입 ① 애플워치 운동 · HAE 체성분 (api/health-import.js · api/body-import.js)
# 아래 3종이 전부 있어야 수신이 열린다 — 하나라도 없으면 503으로 잠긴다(실수 배포 방지).
# Firebase: 함수 그룹 `ingress`
# ─────────────────────────────────────────────

# 【시크릿】 단축어가 X-Import-Token 헤더에 실어 보낼 비밀값. 생성 예: openssl rand -hex 32
IMPORT_TOKEN=
# 기록 주인의 Firebase uid — 수신분이 귀속될 사서함의 주인 (비밀 아님 · 그러나 커밋 금지)
IMPORT_UID=
# 이 날짜(YYYY-MM-DD) 이전에 "시작된" 운동은 거부 — 과거 수동 기록과 이중 계상 차단
IMPORT_CUTOVER_DATE=
# 체성분 컷오버(위와 독립) — 이 날짜 이전 측정은 거부
IMPORT_BODY_CUTOVER_DATE=
# 수신 시각을 사용자 벽시계로 재표기할 시간대 (선택 — 기본 +09:00)
# IMPORT_TZ_OFFSET=+09:00

# ─────────────────────────────────────────────
# 자동 유입 ② 인바디 클라우드 직수신 (api/_lib/inbody-cloud.js) — 🔒 **봉인 중**
#
# 이전 후 Firebase에서는 **이 시크릿을 만들지 않는다**(DR-6). 값이 없으면 이 기능만 꺼지고
# 나머지는 정상 동작한다 — 코드는 감사로 검증된 자산이라 그대로 두고 값만 비운다.
# 재개하려면 운영자가 콘솔에서 직접 시크릿을 만들고 `import-inbox` 함수에 바인딩한다.
#
# ⚠️ 사고 반경: 아래 두 값은 인바디 계정의 **로그인 자격증명 그 자체**다. 유출되면 이 앱의
#    데이터가 아니라 인바디 계정 전체(측정 이력 전부)가 열린다. 다른 env와 위험도가 다르다.
#    - 저장 위치는 시크릿 저장소 한 곳으로 유지한다(코드·백업 파일·로그에 넣지 않는다).
#    - 이 앱은 실패 시 로그에 값이 아니라 "형태"(길이·앞 3자)만 남긴다.
#    - 유출이 의심되면 인바디 앱에서 비밀번호를 먼저 바꾸고, 그 다음 이 값을 교체한다.
#    - 인바디는 **연속 로그인 실패 3회에 계정을 잠근다**. 값을 바꿀 때 오타를 내면 잠길 수
#      있으므로, 저장 직후 설정 카드의 "지금 확인"으로 1회만 검증한다(연타 금지).
# ─────────────────────────────────────────────

INBODY_LOGIN_ID=
INBODY_LOGIN_PW=
# 국가 코드 (선택 — 기본 KR)
# INBODY_COUNTRY=KR

# ─────────────────────────────────────────────
# 공유 뷰 진단용 고정 토큰 (선택 — 가상 샘플 페이지를 여는 용도)
# 미설정이면 해당 경로만 비활성. ?diag=1 진단 응답에는 값이 아니라 설정 여부·길이만 실린다.
# Firebase에서는 어느 함수에도 바인딩하지 않는다(DR-7) → 진단 샘플 경로만 off.
# ─────────────────────────────────────────────

SHARE_TEST_TOKEN=

# ─────────────────────────────────────────────
# Rate Limit · 사서함 · 푸시 구독 · 공유 스냅샷 저장소 (Upstash Redis REST)
# 미설정 시 rate limit은 fail-open으로 통과되고, 사서함·푸시·공유는 비활성이 된다.
# URL은 호스트일 뿐이라 비밀이 아니고, TOKEN은 【시크릿】이다(네 그룹 전부에 바인딩).
# 코드가 두 이름 쌍을 다 읽는다 — 둘 중 **한 쌍만** 설정한다.
# ─────────────────────────────────────────────

KV_REST_API_URL=
KV_REST_API_TOKEN=
# 또는
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 참고:
#  - Vercel은 VERCEL_URL, VERCEL_ENV, VERCEL_GIT_*, NODE_ENV 를 자동 주입한다(설정 불필요).
#  - Cloud Run(Functions v2)은 K_SERVICE, K_REVISION 을 자동 주입한다 — /export/diag가
#    Vercel 값이 없을 때 이 둘로 "어느 배포가 응답했나"를 표시한다.
